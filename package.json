{
  "name": "@visualsentinel/mcp-server",
  "version": "0.2.2",
  "description": "Model Context Protocol server for Visual Sentinel website monitoring. Catches pages that look broken even when the site is up: uptime, performance, SSL, DNS, visual regression and content change, from Claude, Cursor, Cline, Continue and any MCP client. Five tools need no account; account tools need an API key (Business and Agency plans).",
  "type": "module",
  "bin": {
    "visualsentinel-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "ai-agents",
    "claude",
    "claude-desktop",
    "cline",
    "cursor",
    "dns",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ssl",
    "uptime",
    "visual-regression",
    "visual-sentinel",
    "website-monitoring"
  ],
  "author": "Visual Sentinel <support@visualsentinel.com>",
  "license": "MIT",
  "homepage": "https://github.com/VisualSentinel/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisualSentinel/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/VisualSentinel/mcp-server/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.VisualSentinel/mcp-server"
}
